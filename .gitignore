.kaji/artifacts/

# Secrets (generated, not source)
# Ignore all secrets content but keep committed templates (*.env.example).
secrets/*
!secrets/*.env.example
*.pem
.playwright-mcp/
backups/

# Local-only artifacts (smoke runs, benchmark outputs). Git-managed 外。
.local/
