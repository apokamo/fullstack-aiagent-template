*.tmp
*.bak
*.swp~
*.orig

# Project specific
*.log
# アプリのログ出力（dev は repo bind mount で logs/ に書かれる）。
# LLM の prompt / response 全文を含みうるため誤コミットを防ぐ
logs/
*.db
*.sqlite
*.sqlite3
tmp/
temp/

# Bugfix agent artifacts and temporary files
tmp/bugfix_artifacts/
tmp/investigation_report_*.json
tmp/plan_*.json
tmp/fix_report_*.json
tmp/runlog_*.json
tmp/phase_comment_*.md
tmp/pr_body_*.md

