# Docker ignore file

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.venv-*/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Version control
.git/
.gitignore
.github/

# Documentation
docs/
*.md
!README.md

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.coverage.*
coverage.xml
*.cover
.hypothesis/
test-artifacts/
test-results/
playwright-report/
blob-report/

# Logs
logs/
*.log

# Database
*.db
*.sqlite3

# Environment files
.env
.env.*
!.env.example

# Secrets — never bake these into an image layer.
# secrets/*.env は compose の `env_file` が **runtime に** 環境変数として渡すもので、
# イメージに入れる必要は無い。COPY . . で拾われると、レイヤから資格情報を取り出せる
# イメージが出来上がる（registry に push した時点で漏洩）。
# .gitignore で除外していても build context には効かないので、ここでも外す。
secrets/

# Node.js (if any frontend assets)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.orig

# Large local-only artifacts
backups/
.kaji/
.mypy_cache/
.ruff_cache/
.serena/
.claude/
.local/
.playwright-mcp/

# Frontend generated artifacts
apps/web/.next/
apps/web/node_modules/
apps/web/playwright-report/
apps/web/test-results/
apps/web/tmp/
apps/web/.playwright-mcp/

# Work directories
work/
scripts/local/

# CI/CD
.github/workflows/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# IDE and editor files
*.sublime-*
.vscode/
.idea/
*.vim

# Backup files
*.backup
*.bak
