{
  "version": "sample-tools-v1",
  "note": "M1〜M8。文面は固定文であり、実行時に組み立てない。12 user turn / 1 repeat、承認再開は最大 4 run / 1 repeat。",
  "cases": [
    {
      "id": "M1",
      "prompt": "サンプル文書でテストのtierを検索して説明してください。",
      "expected_tools": ["search_docs"],
      "forbidden_tools": ["save_note"],
      "expected_documents": ["testing-tiers"],
      "max_calls": 2,
      "approval": "none"
    },
    {
      "id": "M2",
      "prompt": "サンプル文書にある火星基地の勤務規則を検索してください。",
