        {
          "prompt": "一時メモに、見出し『エラー』、本文『エラー契約を確認した』を書き留めてください。",
          "expected_tools": ["save_note"],
          "argument_contains_all": {
            "save_note": ["エラー", "エラー契約を確認した"]
