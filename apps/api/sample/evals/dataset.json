      "expected_documents": [],
      "max_calls": 2,
      "approval": "none"
    },
    {
      "id": "M3",
      "prompt": "一時メモに、見出し『確認』、本文『テスト規約を確認する』を書き留めてください。",
      "expected_tools": ["save_note"],
      "argument_contains_all": {
        "save_note": ["確認", "テスト規約を確認する"]
      },
      "max_calls": 2,
      "approval": "approve"
    },
    {
